      "alerts": [
        {
          "event": "Coastal Flood Advisory",
          "headline": "Coastal Flood Advisory issued October 29 at 3:10PM PDT until November 1 at 6:00PM PST by NWS San Francisco CA",
          "severity": "Minor",
          "urgency": "Expected",
          "description": "* WHAT...Up to 1.9 ft of inundation above ground level is\npossible in low-lying areas near shorelines and tidal\nwaterways.\n\n* WHERE...Bay Shoreline locations of San Pablo Bay, San\nFrancisco Bay, and Monterey Bay.\n\n* WHEN...Until 6 PM PDT Sunday.\n\n* IMPACTS...High tides will result in flooding of low-lying\ninfrastructure, isolated road closures, and coastal erosion.\nRising tides will bring water and waves farther up the beach\nthan normal, restricting escape from beaches and coastal\nareas. More substantial impacts are expected along bayshore\nMarin County where increased flooding is anticipated across\nlow lying areas.\n\n* ADDITIONAL DETAILS...At the San Francisco tidal gauge, high tide\nis expected to be 1.9 ft above normal (7.7 ft MLLW) at 02:39 PM\nFriday 10/30, 1.5 feet above normal (7.3 ft MLLW) at 03:44 PM on\nSaturday 10/31, and 1.0 ft above normal (6.8 ft MLLW) on Sunday\n11/01 at 3:59 PM. These predictions include up to 1.5 ft of\nsurge that will enhance the astronomical tide and flooding\nthreat. High tide varies up to 90 minutes earlier or later along\nthe Pacific Coast and through the San Francisco Bay,\nrespectively.",
          "instruction": "If travel is required, allow extra time as some roads may be\nclosed. Do not drive around barricades or through water of\nunknown depth. Take the necessary actions to protect flood-prone\nproperty.",
          "expires": "2026-10-30T16:00:00-07:00",
          "source_url": "https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.de0113702fa3f03777d691bb2397e96c5d340ff6.001.1"
        }
      ]
