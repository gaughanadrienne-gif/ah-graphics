      "alerts": [
        {
          "event": "Heat Advisory",
          "headline": "Heat Advisory issued October 3 at 7:48PM PDT until October 4 at 10:00PM PDT by NWS San Francisco CA",
          "severity": "Moderate",
          "urgency": "Expected",
          "description": "* WHAT...Hot conditions with maximum temperatures in the low-80s to\nlow-90s. Mild minimum temperatures and weak onshore flow will limit\novernight relief.\n\n* WHERE...The Marin Hills, Northern Monterey Bay, San Francisco, and\nNorthern Salinas Valley/Hollister Valley and Carmel Valley.\n\n* WHEN...Until 10 PM PDT Sunday.\n\n* IMPACTS...This level of heat affects anyone without effective\ncooling and/or adequate hydration. Impacts likely in some health\nsystems, heat-sensitive industries and infrastructure.",
          "instruction": "Hydration is a critical piece to surviving the heat. Drink water, and\nif possible, take water to those who are vulnerable.\n\nTake extra precautions when outside. Wear lightweight and loose\nfitting clothing. Try to limit strenuous activities to the early\nmorning or evening. Take action when you experience symptoms of heat\nexhaustion and/or heat stroke.\n\nBeat the heat and check the backseat! Do not leave young children or\npets in unattended vehicles. Car interiors will reach lethal\ntemperatures in a matter of minutes.",
          "expires": "2026-10-04T22:00:00-07:00",
          "source_url": "https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.bb08928e50c29e025b51bdcbf1f5ace5c9e39054.002.1"
