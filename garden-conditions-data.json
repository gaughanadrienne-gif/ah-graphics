      "alerts": [
        {
          "event": "Coastal Flood Advisory",
          "headline": "Coastal Flood Advisory issued August 9 at 10:28AM PDT until August 13 at 2:00AM PDT by NWS San Francisco CA",
          "severity": "Minor",
          "urgency": "Expected",
          "description": "* WHAT...Up to 1.6 ft of inundation above ground level is\npossible in low-lying areas near shorelines and tidal\nwaterways.\n\n* WHERE...Bayshore locations along the San Francisco Bay, San\nPablo Bay, and Monterey Bay.\n\n* WHEN...Until 2 AM PDT Thursday.\n\n* IMPACTS...Flooding of lots, parks, and roads with only\nisolated road closures expected.\n\n* ADDITIONAL DETAILS...At the San Francisco tidal gauge, high\ntide is expected to be 1.5 ft above normal (7.34 ft MLLW) at\n9:02 PM Sunday 8/9, 1.5 ft above normal (7.36 ft MLLW) at\n10:01 PM Monday 8/10, 1.6 ft above normal (7.44 ft MLLW) at\n10:57 PM Tuesday 8/11, and 1.3 ft above normal (7.14 ft MLLW)\nat 11:49 PM Wednesday 8/12. These predictions include both\nastronomical tides and roughly 3-6 inches of additional water\nmainly from a combination of thermal expansion and accumulated\nsea level rise since the tidal datum was established (1983-\n2001). High tide varies up to 90 minutes earlier or later\nalong the Pacific Coast and through the San Francisco Bay,\nrespectively.",
          "instruction": "If travel is required, allow extra time as some roads may be\nclosed. Do not drive around barricades or through water of\nunknown depth. Take the necessary actions to protect flood-prone\nproperty.",
          "expires": "2026-08-09T22:00:00-07:00",
          "source_url": "https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.fd9a676b1e5cf732b7ef354986e0c5e31b311280.001.1"
        }
      ]
