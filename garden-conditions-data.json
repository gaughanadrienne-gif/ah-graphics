      "alerts": [
        {
          "event": "Coastal Flood Advisory",
          "headline": "Coastal Flood Advisory issued October 27 at 3:11PM PDT until October 30 at 5:00PM PDT by NWS San Francisco CA",
          "severity": "Minor",
          "urgency": "Expected",
          "description": "* WHAT...Up to 2.1 ft of inundation above ground level is\npossible in low-lying areas near shorelines and tidal\nwaterways.\n\n* WHERE...Bay Shoreline locations of San Pablo Bay, San\nFrancisco Bay, and Monterey Bay.\n\n* WHEN...Until 5 PM PDT Friday.\n\n* IMPACTS...High tides will result in flooding of low-lying\ninfrastructure, isolated road closures, and coastal erosion.\nRising tides will bring water and waves farther up the beach\nthan normal, restricting escape from beaches and coastal\nareas. More substantial impacts are expected along bayshore\nMarin County where increased flooding is anticipated across\nlow lying areas.\n\n* ADDITIONAL DETAILS...At the San Francisco tidal gauge, high tide\nis expected to be 1.9 ft above normal (7.7 ft MLLW) at 12:56 PM\nWednesday 10/28, 1.7 ft above normal (7.5 ft MLLW) at 01:43 PM\nThursday 10/29, and 1.6 ft above normal (7.4 ft MLLW) at 02:39\nPM Friday 10/30. These predictions include up to 1.2 ft of surge\nthat will enhance the astronomical tide and flooding threat.\nHigh tide varies up to 90 minutes earlier or later along the\nPacific Coast and through the San Francisco Bay, respectively.",
          "instruction": "If travel is required, allow extra time as some roads may be\nclosed. Do not drive around barricades or through water of\nunknown depth. Take the necessary actions to protect flood-prone\nproperty.",
          "expires": "2026-10-28T02:00:00-07:00",
          "source_url": "https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.bf7d0f8a6f43cc09077d0dc2c0e11efe0c25a26c.001.1"
        }
      ]
