      "alerts": [
        {
          "event": "Coastal Flood Advisory",
          "headline": "Coastal Flood Advisory issued October 26 at 11:04AM PDT until October 29 at 3:00PM PDT by NWS San Francisco CA",
          "severity": "Minor",
          "urgency": "Expected",
          "description": "* WHAT...Up to 2.1 ft of inundation above ground level is\npossible in low-lying areas near shorelines and tidal waterways.\n\n* WHERE...Bay Shoreline locations of San Pablo Bay, San\nFrancisco Bay, and Monterey Bay.\n\n* WHEN...Until 3 PM PDT Thursday.\n\n* IMPACTS...High tides will result in flooding of low-lying\ninfrastructure, isolated road closures, and coastal erosion.\nRising tides will bring water and waves farther up the beach\nthan normal, restricting escape from beaches and coastal\nareas. More substantial impacts are expected along bayshore\nMarin County where increased flooding is anticipated across\nlow lying areas.\n\n* ADDITIONAL DETAILS...At the San Francisco tidal gauge, high\ntide is expected to be 2.0 ft above normal (7.8 ft MLLW) at\n11:39 AM Monday 10/26, 2.1 ft above normal (7.9 ft MLLW) at\n12:15 PM Tuesday 10/27, 1.9 ft above normal (7.7 ft MLLW) at\n12:56 PM Wednesday 10/28, and 1.7 ft above normal (7.5 ft\nMLLW) at 01:43 PM Thursday 10/29. These predictions include up\nto 1.0 ft of surge that will enhance the astronomical tide and\nflooding threat. High tide varies up to 90 minutes earlier or\nlater along the Pacific Coast and through the San Francisco\nBay, respectively.",
          "instruction": "If travel is required, allow extra time as some roads may be\nclosed. Do not drive around barricades or through water of\nunknown depth. Take the necessary actions to protect flood-prone\nproperty.",
          "expires": "2026-10-26T21:00:00-07:00",
          "source_url": "https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.51d9e89cfafae5087c38c2348ed00b61d1ce0129.001.1"
        }
      ]
