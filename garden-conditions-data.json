      "alerts": [
        {
          "event": "Coastal Flood Advisory",
          "headline": "Coastal Flood Advisory issued August 9 at 9:43PM PDT until August 13 at 2:00AM PDT by NWS San Francisco CA",
          "severity": "Minor",
          "urgency": "Expected",
          "description": "* WHAT...Up to 1.6 ft of inundation above ground level is\npossible in low-lying areas near shorelines and tidal\nwaterways.\n\n* WHERE...Bayshore locations along the San Francisco Bay, San\nPablo Bay, and Monterey Bay.\n\n* WHEN...Until 2 AM PDT Thursday.\n\n* IMPACTS...Flooding of lots, parks, and roads with only\nisolated road closures expected.\n\n* ADDITIONAL DETAILS...At the San Francisco tidal gauge, high tide\nis expected to be 1.6 ft above normal (7.46 ft MLLW) at 10:01 PM\nMonday 8/10, 1.6 ft above normal (7.44 ft MLLW) at 10:57 PM\nTuesday 8/11, and 1.4 ft above normal (7.24 ft MLLW) at 11:49 PM\nWednesday 8/12. These predictions include both astronomical\ntides and roughly 3-6 inches of additional water mainly from a\ncombination of thermal expansion and accumulated sea level rise\nsince the tidal datum was established (1983-2001). High tide\nvaries up to 90 minutes earlier or later along the Pacific Coast\nand through the San Francisco Bay, respectively.",
          "instruction": "If travel is required, allow extra time as some roads may be\nclosed. Do not drive around barricades or through water of\nunknown depth. Take the necessary actions to protect flood-prone\nproperty.",
          "expires": "2026-08-10T23:00:00-07:00",
          "source_url": "https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.a3a515a39fed217747f34da5d576522adc521f48.001.1"
        }
      ]
