      "alerts": [
        {
          "event": "Heat Advisory",
          "headline": "Heat Advisory issued October 3 at 2:02AM PDT until October 4 at 10:00PM PDT by NWS San Francisco CA",
          "severity": "Moderate",
          "urgency": "Expected",
          "description": "* WHAT...For the Dense Fog Advisory, visibility one quarter mile or\nless in dense fog. For the Heat Advisory, hot conditions with\nmaximum temperatures in the low-80s to low-90s. Mild minimum\ntemperatures and weak onshore flow will limit overnight relief.\n\n* WHERE...Northern Monterey Bay.\n\n* WHEN...For the Dense Fog Advisory, until 9 AM PDT this morning. For\nthe Heat Advisory, from 11 AM this morning to 10 PM PDT Sunday.\n\n* IMPACTS...For the Dense Fog Advisory, low visibility could make\ndriving conditions hazardous. For the Heat Advisory, this level of\nheat affects anyone without effective cooling and/or adequate\nhydration. Impacts likely in some health systems, heat-sensitive\nindustries and infrastructure.",
          "instruction": "For the Dense Fog Advisory, if driving, slow down, use your\nheadlights, and leave plenty of distance ahead of you.\n\nHydration is a critical piece to surviving the heat. Drink water, and\nif possible, take water to those who are vulnerable.\n\nTake extra precautions when outside. Wear lightweight and loose\nfitting clothing. Try to limit strenuous activities to the early\nmorning or evening. Take action when you experience symptoms of heat\nexhaustion and/or heat stroke.\n\nBeat the heat and check the backseat! Do not leave young children or\npets in unattended vehicles. Car interiors will reach lethal\ntemperatures in a matter of minutes.",
          "expires": "2026-10-03T09:15:00-07:00",
          "source_url": "https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.8c49d62f93996a96cb756c4569a6927363ae308c.001.2"
        },
